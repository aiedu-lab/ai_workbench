.env
.venv/
node_modules/
.tmp/
*.log

# ignored stored snapshots of Jupyter Lab
.ipynb_checkpoints/ 

# ignore language specific generated directories
__pycache__/

# Bazel build outputs and external repo cache
bazel-*
external/

# Obsidian workspace state (machine-specific, regenerates automatically)
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json

# Analysis outputs are local query results â€” do not commit.
**/analysis/

# Raw sources are ephemeral processing inputs â€” do not commit.
# Public articles can be re-fetched from URLs in articles.md.
# Private articles are sensitive; delete from disk after ingestion.
# The knowledge graph (concepts/, people/, tech/, ...) is the
# durable artifact â€” raw_sources/ is not needed once ingested.
**/raw_sources/

# Embedding — venv, GloVe cache, plot outputs, generated notebook
projects/embedding/.venv/
projects/embedding/*.bin
projects/embedding/*.png
projects/embedding/*.ipynb

# Windows noise
Thumbs.db
desktop.ini

# Obsidian temp files
*.tmp.*

# Devcontainer is materialized only on macOS by setup/labsetup.py;
# canonical source files live in tools/VM/devcontainer/.
.devcontainer/

# Local, machine-specific opt-out for act_check.py (act validation)
.act_check_skip
